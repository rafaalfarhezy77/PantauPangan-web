```sql
-- ============================================================
-- SQL PC1: Database Pantau Pangan (Server Utama)
-- Jalankan di: phpMyAdmin PC1 → http://localhost/phpmyadmin
-- ============================================================

CREATE DATABASE IF NOT EXISTS db_pantaupangan 
    CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

USE db_pantaupangan;

-- ── Tabel users ──────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS users (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    email_verified_at TIMESTAMP NULL,
    password VARCHAR(255) NOT NULL,
    role ENUM('superadmin','admin-komoditas','admin-berita','petani','pembeli','tengkulak','pedagang','dinas pemerintah','lainnya') NOT NULL DEFAULT 'pembeli',
    instansi_dinas VARCHAR(255) NULL,
    created_by VARCHAR(255) NULL,
    updated_by VARCHAR(255) NULL,
    remember_token VARCHAR(100) NULL,
    created_at TIMESTAMP NULL,
    updated_at TIMESTAMP NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ── Tabel komoditas ──────────────────────────────────────────
CREATE TABLE IF NOT EXISTS komoditas (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nama_komoditas VARCHAR(255) NOT NULL,
    slug_komoditas VARCHAR(255) NOT NULL UNIQUE,
    kategori VARCHAR(255) NULL,
    icon VARCHAR(255) NULL,
    status ENUM('aktif','nonaktif') NOT NULL DEFAULT 'aktif',
    created_at TIMESTAMP NULL,
    updated_at TIMESTAMP NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ── Tabel harga_harian ───────────────────────────────────────
CREATE TABLE IF NOT EXISTS harga_harian (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    slug_komoditas VARCHAR(255) NOT NULL,
    provinsi VARCHAR(255) NOT NULL,
    harga INT NOT NULL,
    tanggal DATE NOT NULL,
    created_at TIMESTAMP NULL,
    updated_at TIMESTAMP NULL,
    INDEX idx_slug (slug_komoditas),
    INDEX idx_provinsi (provinsi),
    INDEX idx_tanggal (tanggal),
    UNIQUE KEY uq_harga (slug_komoditas, provinsi, tanggal)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ── Tabel hasil_panen ────────────────────────────────────────
CREATE TABLE IF NOT EXISTS hasil_panen (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT UNSIGNED NOT NULL,
    nama_komoditas VARCHAR(255) NOT NULL,
    jumlah DECIMAL(10,2) NOT NULL,
    satuan VARCHAR(50) NOT NULL DEFAULT 'kg',
    tanggal_panen DATE NOT NULL,
    lokasi_lahan VARCHAR(255) NULL,
    created_at TIMESTAMP NULL,
    updated_at TIMESTAMP NULL,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ── Tabel migrations (wajib untuk Laravel) ───────────────────
CREATE TABLE IF NOT EXISTS migrations (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    migration VARCHAR(255) NOT NULL,
    batch INT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ── Tabel sessions (wajib untuk Laravel session) ─────────────
CREATE TABLE IF NOT EXISTS sessions (
    id VARCHAR(255) PRIMARY KEY,
    user_id BIGINT UNSIGNED NULL,
    ip_address VARCHAR(45) NULL,
    user_agent TEXT NULL,
    payload LONGTEXT NOT NULL,
    last_activity INT NOT NULL,
    INDEX idx_user_id (user_id),
    INDEX idx_last_activity (last_activity)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ── Tabel cache ──────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS cache (
    `key` VARCHAR(255) PRIMARY KEY,
    value MEDIUMTEXT NOT NULL,
    expiration INT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS cache_locks (
    `key` VARCHAR(255) PRIMARY KEY,
    owner VARCHAR(255) NOT NULL,
    expiration INT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ── Tabel jobs (queue) ───────────────────────────────────────
CREATE TABLE IF NOT EXISTS jobs (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    queue VARCHAR(255) NOT NULL,
    payload LONGTEXT NOT NULL,
    attempts TINYINT UNSIGNED NOT NULL,
    reserved_at INT UNSIGNED NULL,
    available_at INT UNSIGNED NOT NULL,
    created_at INT UNSIGNED NOT NULL,
    INDEX idx_queue (queue)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

