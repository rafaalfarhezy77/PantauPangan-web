#### `sql_pc2.sql` — Dijalankan di phpMyAdmin PC2

```sql
-- ============================================================
-- SQL PC2: Database Distribusi Pupuk (Server Kedua)
-- Jalankan di: phpMyAdmin PC2 → http://localhost/phpmyadmin
-- ============================================================

CREATE DATABASE IF NOT EXISTS db_distribusi_pupuk
    CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

USE db_distribusi_pupuk;

-- ── Tabel pupuk ──────────────────────────────────────────────
-- Master data jenis pupuk subsidi pemerintah
CREATE TABLE IF NOT EXISTS pupuk (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    kode_pupuk VARCHAR(20) NOT NULL UNIQUE,
    nama_pupuk VARCHAR(100) NOT NULL,
    satuan VARCHAR(20) NOT NULL DEFAULT 'kg',
    harga_subsidi INT NOT NULL COMMENT 'Harga dalam Rupiah per kg/liter',
    harga_nonsubsidi INT NOT NULL COMMENT 'Harga pasaran per kg/liter',
    deskripsi TEXT NULL,
    status ENUM('aktif','nonaktif') NOT NULL DEFAULT 'aktif',
    created_at TIMESTAMP NULL,
    updated_at TIMESTAMP NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Master data jenis pupuk subsidi — DB Server 2 (PC2)';

-- ── Tabel distribusi_pupuk ───────────────────────────────────
-- Data distribusi pupuk per provinsi per periode
CREATE TABLE IF NOT EXISTS distribusi_pupuk (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    kode_pupuk VARCHAR(20) NOT NULL,
    provinsi VARCHAR(100) NOT NULL,
    kuota_ton DECIMAL(10,2) NOT NULL COMMENT 'Kuota dalam Ton',
    realisasi_ton DECIMAL(10,2) NOT NULL DEFAULT 0.00 COMMENT 'Realisasi penyaluran dalam Ton',
    periode VARCHAR(20) NOT NULL COMMENT 'Format: YYYY-Q1/Q2/Q3/Q4',
    tanggal_distribusi DATE NOT NULL,
    keterangan TEXT NULL,
    created_at TIMESTAMP NULL,
    updated_at TIMESTAMP NULL,
    INDEX idx_kode_pupuk (kode_pupuk),
    INDEX idx_provinsi (provinsi),
    INDEX idx_periode (periode),
    FOREIGN KEY (kode_pupuk) REFERENCES pupuk(kode_pupuk) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Data distribusi pupuk subsidi per wilayah — DB Server 2 (PC2)';

-- ── Tabel alokasi_pupuk ──────────────────────────────────────
-- Pengajuan alokasi pupuk dari petani (user_id merujuk ke DB1)
CREATE TABLE IF NOT EXISTS alokasi_pupuk (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT UNSIGNED NOT NULL COMMENT 'Merujuk ke users.id di DB Server 1 (PC1)',
    kode_pupuk VARCHAR(20) NOT NULL,
    jumlah_kg DECIMAL(10,2) NOT NULL,
    provinsi VARCHAR(100) NOT NULL,
    status ENUM('pending','disetujui','ditolak') NOT NULL DEFAULT 'pending',
    tanggal_pengajuan DATE NOT NULL,
    catatan TEXT NULL,
    created_at TIMESTAMP NULL,
    updated_at TIMESTAMP NULL,
    INDEX idx_user_id (user_id),
    INDEX idx_kode_pupuk (kode_pupuk),
    INDEX idx_status (status),
    FOREIGN KEY (kode_pupuk) REFERENCES pupuk(kode_pupuk)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
COMMENT='Pengajuan alokasi pupuk oleh petani — DB Server 2 (PC2)';

