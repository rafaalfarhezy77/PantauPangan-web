### 📄 `index.php` — Dashboard Utama (Bukti Sistem Terdistribusi)

```php
<?php
require_once 'config.php';

// ════════════════════════════════════════════════════════════════
// QUERY DB SERVER 1 — PC1: Harga Komoditas Terkini
// ════════════════════════════════════════════════════════════════
$db1   = koneksi_db1();
$t_db1 = microtime(true);

$sql_komoditas = "
    SELECT k.nama_komoditas, k.kode, k.kategori,
           h.harga, h.provinsi, h.tanggal
    FROM komoditas k
    JOIN harga_harian h ON k.kode = h.kode_komoditas
    WHERE h.tanggal = (
        SELECT MAX(tanggal) FROM harga_harian WHERE kode_komoditas = k.kode AND provinsi = 'Nasional'
    )
    AND h.provinsi = 'Nasional'
    AND k.status = 'aktif'
    ORDER BY k.nama_komoditas
";
$res_komoditas = $db1->query($sql_komoditas);
$harga_list    = $res_komoditas ? $res_komoditas->fetch_all(MYSQLI_ASSOC) : [];

$sql_stat_db1  = "SELECT COUNT(*) AS total FROM harga_harian";
$total_harga   = $db1->query($sql_stat_db1)->fetch_assoc()['total'];

$waktu_db1     = round((microtime(true) - $t_db1) * 1000, 2);

// ════════════════════════════════════════════════════════════════
// QUERY DB SERVER 2 — PC2: Distribusi Pupuk Terkini
// ════════════════════════════════════════════════════════════════
$db2   = koneksi_db2();
$t_db2 = microtime(true);

$sql_pupuk = "
    SELECT p.kode_pupuk, p.nama_pupuk, p.harga_subsidi, p.harga_pasaran,
           SUM(d.kuota_ton) AS total_kuota,
           SUM(d.realisasi_ton) AS total_realisasi,
           ROUND(SUM(d.realisasi_ton) / SUM(d.kuota_ton) * 100, 1) AS persen
    FROM pupuk p
    LEFT JOIN distribusi_pupuk d ON p.kode_pupuk = d.kode_pupuk
    WHERE p.status = 'aktif'
    GROUP BY p.kode_pupuk, p.nama_pupuk, p.harga_subsidi, p.harga_pasaran
    ORDER BY total_kuota DESC
";
$res_pupuk  = $db2->query($sql_pupuk);
$pupuk_list = $res_pupuk ? $res_pupuk->fetch_all(MYSQLI_ASSOC) : [];

$sql_alokasi   = "SELECT COUNT(*) AS total, SUM(jumlah_kg) AS total_kg FROM alokasi_pupuk WHERE status = 'disetujui'";
$stat_alokasi  = $db2->query($sql_alokasi)->fetch_assoc();
$total_alokasi = $stat_alokasi['total'] ?? 0;
