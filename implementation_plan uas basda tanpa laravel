## KODE APLIKASI PHP MURNI

### 📄 `config.php`

```php
<?php
// ============================================================
// Konfigurasi Koneksi Dua Database
// Letakkan di: C:\xampp\htdocs\distribusi\config.php
// ============================================================

// ─── Ganti IP_PC2 dengan IP aktual PC2 ───────────────────────
define('IP_PC2', '192.168.X.X');   // ← GANTI INI

// ─── Koneksi DB Server 1 — PC1 (localhost) ───────────────────
function koneksi_db1() {
    $host = '127.0.0.1';
    $db   = 'db_pantaupangan';
    $user = 'root';
    $pass = '';        // kosong = default XAMPP
    $port = 3306;

    $conn = new mysqli($host, $user, $pass, $db, $port);
    if ($conn->connect_error) {
        die("<div class='alert error'>❌ Gagal koneksi ke DB Server 1 (PC1): " . $conn->connect_error . "</div>");
    }
    $conn->set_charset('utf8mb4');
    return $conn;
}

// ─── Koneksi DB Server 2 — PC2 (remote via WiFi) ─────────────
function koneksi_db2() {
    $host = IP_PC2;
    $db   = 'db_distribusi_pupuk';
    $user = 'distribusi';
    $pass = 'password123';
    $port = 3306;

    $conn = new mysqli($host, $user, $pass, $db, $port);
    if ($conn->connect_error) {
        die("<div class='alert error'>❌ Gagal koneksi ke DB Server 2 (PC2 - " . IP_PC2 . "): " . $conn->connect_error . "</div>");
    }
    $conn->set_charset('utf8mb4');
    return $conn;
}
```

