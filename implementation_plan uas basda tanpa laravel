<?php
require_once 'config.php';

$pesan  = '';
$error  = '';

// Proses form POST → simpan ke DB Server 2
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $db2          = koneksi_db2();
    $pengguna_id  = (int) $_POST['pengguna_id'];
    $nama_pemohon = trim($_POST['nama_pemohon']);
    $kode_pupuk   = $db2->real_escape_string(trim($_POST['kode_pupuk']));
    $jumlah_kg    = (float) $_POST['jumlah_kg'];
    $provinsi     = $db2->real_escape_string(trim($_POST['provinsi']));
    $catatan      = $db2->real_escape_string(trim($_POST['catatan'] ?? ''));
    $tanggal      = date('Y-m-d');

    if ($pengguna_id > 0 && $jumlah_kg > 0 && $kode_pupuk && $provinsi) {
        $sql = "INSERT INTO alokasi_pupuk 
                (pengguna_id, nama_pemohon, kode_pupuk, jumlah_kg, provinsi, status, tanggal_pengajuan, catatan, dibuat_pada)
                VALUES ($pengguna_id, '$nama_pemohon', '$kode_pupuk', $jumlah_kg, '$provinsi', 'pending', '$tanggal', '$catatan', NOW())";
        if ($db2->query($sql)) {
            $pesan = "✅ Pengajuan berhasil disimpan ke DB Server 2 (PC2)! ID: " . $db2->insert_id;
        } else {
            $error = "❌ Gagal menyimpan: " . $db2->error;
        }
    } else {
        $error = "❌ Harap lengkapi semua field yang wajib diisi.";
    }
    $db2->close();
}

// Ambil data untuk form (DB1 = daftar pengguna, DB2 = daftar pupuk)
$db1       = koneksi_db1();
$pengguna  = $db1->query("SELECT id, nama, role FROM pengguna WHERE role = 'petani' ORDER BY nama")->fetch_all(MYSQLI_ASSOC);
