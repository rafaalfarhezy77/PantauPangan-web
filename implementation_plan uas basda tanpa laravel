-- ============================================================
-- SQL PC 1 — Database Utama: Pantau Pangan
-- Server: PC1 (localhost)
-- Jalankan: mysql -u root -p < sql_pc1.sql
-- ============================================================

CREATE DATABASE IF NOT EXISTS db_pantaupangan
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE db_pantaupangan;

-- ── Tabel pengguna ───────────────────────────────────────────
CREATE TABLE IF NOT EXISTS pengguna (
    id        INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nama      VARCHAR(100) NOT NULL,
    email     VARCHAR(100) NOT NULL UNIQUE,
    role      ENUM('admin','petani','pembeli') NOT NULL DEFAULT 'petani',
    provinsi  VARCHAR(100) NOT NULL DEFAULT 'Jawa Tengah',
    dibuat_pada TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
COMMENT='Data pengguna sistem — DB Server 1 (PC1)';

-- ── Tabel komoditas ──────────────────────────────────────────
CREATE TABLE IF NOT EXISTS komoditas (
    id             INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nama_komoditas VARCHAR(100) NOT NULL,
    kode           VARCHAR(30)  NOT NULL UNIQUE,
    kategori       VARCHAR(50)  NOT NULL DEFAULT 'Pangan Pokok',
    satuan         VARCHAR(20)  NOT NULL DEFAULT 'kg',
    status         ENUM('aktif','nonaktif') NOT NULL DEFAULT 'aktif',
    dibuat_pada    TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
COMMENT='Master data komoditas pangan — DB Server 1 (PC1)';

-- ── Tabel harga_harian ───────────────────────────────────────
CREATE TABLE IF NOT EXISTS harga_harian (
    id             INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    kode_komoditas VARCHAR(30)  NOT NULL,
    provinsi       VARCHAR(100) NOT NULL,
    harga          INT          NOT NULL COMMENT 'Harga dalam Rupiah per kg',
    tanggal        DATE         NOT NULL,
    sumber         VARCHAR(100) NULL DEFAULT 'Panel Harga Pangan',
    dibuat_pada    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_kode     (kode_komoditas),
    INDEX idx_provinsi (provinsi),
    INDEX idx_tanggal  (tanggal),
    UNIQUE KEY uq_harga (kode_komoditas, provinsi, tanggal),
    FOREIGN KEY (kode_komoditas) REFERENCES komoditas(kode) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
COMMENT='Data harga harian komoditas pangan — DB Server 1 (PC1)';

